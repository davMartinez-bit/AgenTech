POSTGRES_DB=agentech
POSTGRES_USER=agentech
POSTGRES_PASSWORD=cambiar_esta_clave
POSTGRES_PORT=5432

# Worker de vectorización (opcional)
POSTGRES_HOST=localhost
OLLAMA_URL=http://127.0.0.1:11434
EMBEDDING_MODEL=nomic-embed-text-v2-moe

# API (src/api)
API_PORT=3000
# Modelo del agente que interpreta los gráficos del panel administrativo
AGENT_MODEL=qwen2.5:7b
# Modelo para enriquecer descripciones del catálogo (worker/enriquecer_descripciones.py); cabe entero en una GPU de 6 GB
ENRICH_MODEL=gemma3:4b
# Umbral de similitud de la búsqueda (0 a 1)
SIMILITUD_MINIMA=0.32
# Peso de la coincidencia de palabras en la búsqueda híbrida (0 = solo semántica)
PESO_TEXTO=0.15
# Carpeta con las fotos <SKU>.jpg del e-commerce (opcional)
FOTOS_DIR=

# Sincronización con Bsale (solo lectura, src/db/scripts/sincronizar_bsale.py)
BSALE_ACCESS_TOKEN=
