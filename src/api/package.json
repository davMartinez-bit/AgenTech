{
  "name": "agentech-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API de ingesta, consulta en lenguaje natural y panel administrativo de AgenTech",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/server.ts",
    "start": "tsx --env-file-if-exists=../.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --env-file-if-exists=../.env --test test/*.test.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "pg": "^8.16.3",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.9.1",
    "@types/pg": "^8.15.5",
    "@types/swagger-ui-express": "^4.1.8",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
